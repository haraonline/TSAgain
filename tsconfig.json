{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {   
    "module": "nodenext",
    "target": "esnext",
    "moduleDetection": "force",
    "lib": ["ES2024","DOM","DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "strictPropertyInitialization": true,
    "noImplicitAny": false,
    "outDir": "dist"
  }
}